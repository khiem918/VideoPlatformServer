{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "vtube",
	"main": "src/index.js",
	"compatibility_date": "2026-04-27",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"compatibility_flags": [
		"nodejs_compat"
	],
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "video-streaming-platform"
		}
	],
