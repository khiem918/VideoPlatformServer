# Copy to search_service/.env and fill in real values. Never commit the
# filled-in .env file — it is gitignored, this template is not.

DATABASE_URL=postgresql://postgres:postgres@localhost:5438/video_streaming_search?schema=core

JWT_SECRET=

QDRANT_URL=http://localhost:6333
REDIS_URL=redis://localhost:6380
MQ_URL=amqp://guest:guest@localhost:5672

GRPC_URL=localhost:50052
API_SERVICE_GRPC_URL=localhost:50051

# S3-compatible object storage (optional; omit to disable S3-backed features)
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=
S3_BUCKET=

CLOUDFRONT_DOMAIN_NAME=

META_CACHE_TTL=36000
