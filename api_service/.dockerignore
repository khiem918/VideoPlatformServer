# Build context for api_service (NestJS)
# Keep build context small — copy only what's needed

# Dependencies
node_modules
npm-debug.log
yarn-debug.log
yarn-error.log
pnpm-debug.log
.pnp
.pnp.js

# Build output
dist
build
coverage
.nyc_output
*.tsbuildinfo

# Tests (not needed in image)
test
**/*.spec.ts
**/*.e2e-spec.ts
jest.config.*

# Git
.git
.gitignore
.gitattributes

# Editor / OS
.vscode
.idea
.DS_Store
Thumbs.db

# Env
.env
.env.*
!.env.example

# Prisma generated artifacts (re-generated inside image)
prisma/migrations/**/migration.sql.bak

# Docker files at this level
Dockerfile
.dockerignore
docker-entrypoint.sh
