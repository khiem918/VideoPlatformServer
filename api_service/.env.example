# Copy to api_service/.env and fill in real values. Never commit the
# filled-in .env file — it is gitignored, this template is not.

NODE_ENV=development
SERVER_PORT=8080

DATABASE_URL=postgresql://postgres:postgres@localhost:5434/video_streaming_api

JWT_SECRET=

COOKIE_SECRET=

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Firebase Admin SDK service account (used for auth verification)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# S3-compatible object storage
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
BUCKET_NAME=

MAX_FILE_SIZE=10737418240

QUEUE_NAME=video-processing-queue
QUEUE_HOST=localhost
QUEUE_PORT=6379

RABBITMQ_URI=amqp://guest:guest@localhost:5672

GRPC_URL=localhost:50051
SEARCH_SERVICE_GRPC_URL=localhost:50052

# CloudFront signed cookies/URLs for private video delivery
CLOUDFRONT_DOMAIN_NAME=
CLOUDFRONT_KEY_PAIR_ID=
CLOUDFRONT_PRIVATE_KEY=
CDN_DOMAIN=

