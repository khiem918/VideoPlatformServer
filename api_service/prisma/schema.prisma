generator client {
  provider        = "prisma-client-py"
  previewFeatures = ["postgresqlExtensions", "multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["core"]
}

model User {
  id                  String                @id
  userName            String?               @map("user_name") @db.VarChar(30)
  userEmail           String                @unique @map("user_email") @db.VarChar(320)
  channelIntro        String?               @map("channel_intro") @db.VarChar(1000)
  subscribeCount      Int                   @default(0) @map("subscribe_count")
  comments            Comment[]
  channelNotification ChannelNotification[]
  likeVideos          LikeVideo[]
  channels            Subscribe[]           @relation("ChannelSubscriptions")
  subscriptions       Subscribe[]           @relation("UserSubscriptions")
  systemNotification  SystemNotification[]
  videos              Video[]
  watchHistory        WatchHistory[]

  @@index([userName])
  @@map("user")
  @@schema("core")
}

model VideoHashtag {
  videoId    String @map("video_id")
  displayTag String @map("display_tag")
  video      Video  @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@id([videoId])
  @@map("video_hashtag")
  @@schema("core")
}

model Subscribe {
  userId          String  @map("user_id")
  channelId       String  @map("channel_id")
  notifySubscribe Boolean @default(true) @map("nofify_subscribe")
  channel         User    @relation("ChannelSubscriptions", fields: [channelId], references: [id], onDelete: Cascade)
  user            User    @relation("UserSubscriptions", fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, channelId])
  @@index([channelId])
  @@map("subscribe")
  @@schema("core")
}

model WatchHistory {
  userId    String   @map("user_id")
  videoId   String   @map("video_id")
  pausedAt  Int      @default(0) @map("paused_at")
  watchedAt DateTime @default(now()) @map("watched_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@id([userId, videoId])
  @@index([videoId])
  @@index([userId, watchedAt(sort: Desc)])
  @@map("watch_history")
  @@schema("core")
}

model Video {
  id                String            @id @default(cuid())
  videoName         String            @default("draft") @map("video_name") @db.VarChar(1000)
  videoReleasedDate DateTime?         @map("video_released_date") @db.Timestamp(6)
  videoView         BigInt            @default(0) @map("video_view")
  videoLike         BigInt            @default(0) @map("video_like")
  videoDislike      BigInt            @default(0) @map("video_dislike")
  userId            String            @map("user_owner")
  owner             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  videoPath         String            @default("") @map("video_url_storage") @db.VarChar(1000)
  thumbnailPath     String            @default("") @map("thumbnail_url") @db.VarChar(1000)
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  visibility        VideoVisibility   @default(DRAFT) @map("video_visibility")
  duration          Int               @default(0) @map("duration")
  videoDesc         String?           @map("video_desc")
  comments          Comment[]
  likeVideos        LikeVideo[]
  information       VideoInformation?
  videoHashtags     VideoHashtag[]
  watchHistory      WatchHistory[]
  videoStatus       VideoStatus?      @map("video_status")

  @@index([id, userId])
  @@index([createdAt(sort: Desc)])
  @@index([visibility, createdAt(sort: Desc)])
  @@index([visibility, videoView(sort: Desc)])
  @@index([videoReleasedDate(sort: Desc)])
  @@map("video")
  @@schema("core")
}

model VideoInformation {
  id               String            @id @default(cuid())
  mimeType         String            @map("mime_type")
  fileName         String            @map("file_name")
  fileSize         BigInt            @map("file_size")
  objectPath       String            @unique @map("object_path")
  videoStatus      UploadVideoStatus @default(PENDING) @map("video_status")
  metaUpdatedAt    DateTime          @default(now()) @map("meta_updated_at")
  videoUpdatedAt   DateTime          @default(now()) @map("video_updated_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  videoId          String            @unique @map("video_id")
  video            Video             @relation(fields: [videoId], references: [id], onDelete: Cascade)
  metaStatus       UploadMetaStatus  @default(PENDING) @map("meta_status")
  videoProcessings VideoProcessing[]

  @@index([metaStatus, videoStatus])
  @@index([videoId, videoStatus, metaStatus])
  @@map("video_information")
  @@schema("core")
}

model VideoProcessing {
  id                 String           @id @default(cuid())
  status             ProcessingStatus @default(PROCESSING) @map("status")
  errorMessage       String?          @map("error_message")
  completedAt        DateTime?        @map("completed_at")
  startedAt          DateTime?        @map("started_at")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  processingType     ProcessingType   @map("processing_type")
  videoInformationId String           @map("video_information_id")
  videoInformation   VideoInformation @relation(fields: [videoInformationId], references: [id], onDelete: Cascade)
  retryCount         Int              @default(0) @map("retry_count")

  @@index([id])
  @@index([status, createdAt(sort: Desc)])
  @@map("video_processing")
  @@schema("core")
}

model LikeVideo {
  userId  String  @map("user_id")
  videoId String  @map("video_id")
  isLike  Boolean @default(true) @map("is_like")
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  video   Video   @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@id([userId, videoId])
  @@index([videoId])
  @@map("like_video")
  @@schema("core")
}

model Comment {
  id         String   @id @default(cuid())
  videoId    String   @map("video_id")
  userId     String   @map("user_id")
  parentId   String?  @map("parent_id")
  content    String   @map("content")
  likeCount  Int      @default(0) @map("like_count")
  replyCount Int      @default(0) @map("reply_count")
  status     Int      @default(0) @map("status")
  createdAt  DateTime @default(now()) @map("created_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  video      Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([videoId, parentId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([likeCount(sort: Desc)])
  @@schema("core")
}

model ChannelNotification {
  id                  String   @id @default(cuid())
  channelId           String   @map("channel_id")
  content             String   @map("content")
  createdAt           DateTime @default(now()) @map("created_at")
  notificationSubject String   @map("notification_subject")
  isRead              Boolean  @default(false) @map("is_read")
  channel             User     @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId])
  @@index([channelId, createdAt(sort: Desc)])
  @@index([channelId, isRead])
  @@map("channel_notification")
  @@schema("core")
}

model SystemNotification {
  id                  String   @id @default(cuid())
  userId              String   @map("user_id")
  content             String   @map("content")
  createdAt           DateTime @default(now()) @map("created_at")
  notificationSubject String   @map("notification_subject")
  isRead              Boolean  @default(false) @map("is_read")
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, isRead])
  @@map("system_notification")
  @@schema("core")
}

enum UploadVideoStatus {
  PENDING
  UPLOADED
  PROCESSING
  PROCESSED
  FAILED

  @@schema("core")
}

enum UploadMetaStatus {
  PENDING
  UPDATED
  PROCESSING
  PROCESSED
  FAILED

  @@schema("core")
}

enum ProcessingStatus {
  PROCESSING
  COMPLETED
  FAILED
  DEAD

  @@schema("core")
}

enum ProcessingType {
  VIDEO
  META

  @@schema("core")
}

enum VideoVisibility {
  DRAFT
  PUBLIC
  PRIVATE

  @@schema("core")
}

enum Resolution {
  x360p
  x480p
  x720p
  x1080p
  x1440p
  x2160p

  @@schema("core")
}

enum VideoStatus {
  AVAILABLE
  PROCESSING

  @@schema("core")
}
