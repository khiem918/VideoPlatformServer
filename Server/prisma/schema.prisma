generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["core"]
}

model User {
  id                  String                @id
  userName            String?               @map("user_name") @db.VarChar(30)
  userEmail           String                @unique @map("user_email") @db.VarChar(320)
  channelIntro        String?               @map("channel_intro") @db.VarChar(1000)
  subscribeCount      Int                   @default(0) @map("subscribe_count")
  comments            Comment[]
  channelNotification ChannelNotification[]
  likeVideos          LikeVideo[]
  channels            Subscribe[]           @relation("ChannelSubscriptions")
  subscriptions       Subscribe[]           @relation("UserSubscriptions")
  systemNotification  SystemNotification[]
  videos              Video[]
  videoUploads        VideoUpload[]
  watchHistory        WatchHistory[]

  @@index([userName])
  @@map("user")
  @@schema("core")
}

/**
 * --------This model is going to be moved to search service
 * model Hashtag {
 * id            String         @id @default(uuid())
 * normalized    String         @unique @map("normalized_tag")
 * count         BigInt         @default(0)
 * isCanoncial   Boolean        @default(false)
 * createdAt     DateTime       @default(now())
 * videoHashtags VideoHashtag[]
 * @@index([count(sort: Desc)])
 * @@index([createdAt(sort: Desc)])
 * @@map("hashtag")
 * @@schema("core")
 * }
 */

model VideoHashtag {
  videoId    String @map("video_id")
  // hashtagId  String  @map("hashtag_id")
  displayTag String @map("display_tag")
  // hashtag    Hashtag @relation(fields: [hashtagId], references: [id], onDelete: Cascade)
  video      Video  @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@id([videoId])
  @@map("video_hashtag")
  @@schema("core")
}

model Subscribe {
  userId          String  @map("user_id")
  channelId       String  @map("channel_id")
  notifySubscribe Boolean @default(true) @map("nofify_subscribe")
  channel         User    @relation("ChannelSubscriptions", fields: [channelId], references: [id], onDelete: Cascade)
  user            User    @relation("UserSubscriptions", fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, channelId])
  @@index([channelId])
  @@map("subscribe")
  @@schema("core")
}

model WatchHistory {
  userId    String   @map("user_id")
  videoId   String   @map("video_id")
  pausedAt  Int      @default(0) @map("paused_at")
  watchedAt DateTime @default(now()) @map("watched_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@id([userId, videoId])
  @@index([videoId])
  @@index([userId, watchedAt(sort: Desc)])
  @@map("watch_history")
  @@schema("core")
}

model Video {
  id                String          @id @default(cuid())
  videoName         String          @default("draft") @map("video_name") @db.VarChar(1000)
  videoReleasedDate DateTime?       @map("video_released_date") @db.Timestamp(6)
  videoView         BigInt          @default(0) @map("video_view")
  videoLike         Int             @default(0) @map("video_like")
  videoDislike      Int             @default(0) @map("video_dislike")
  userOwner         String          @map("user_owner")
  videoUrl          String          @default("") @map("video_url_storage") @db.VarChar(1000)
  thumbnailUrl      String          @default("") @map("thumbnail_url") @db.VarChar(1000)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  visibility        VideoVisibility @default(DRAFT) @map("video_visibility")
  duration          Int             @default(0)
  videoDesc         String?
  comments          Comment[]
  likeVideos        LikeVideo[]
  upload            VideoUpload?
  owner             User            @relation(fields: [userOwner], references: [id], onDelete: Cascade)
  videoHashtags     VideoHashtag[]
  watchHistory      WatchHistory[]
  videoStatus       VideoStatus     @default(PROCESSING) @map("video_status")

  @@index([userOwner])
  @@index([createdAt(sort: Desc)])
  @@index([visibility, createdAt(sort: Desc)])
  @@index([visibility, videoView(sort: Desc)])
  @@index([videoReleasedDate(sort: Desc)])
  @@map("video")
  @@schema("core")
}

model LikeVideo {
  userId  String
  videoId String
  isLike  Boolean @default(true)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  video   Video   @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@id([userId, videoId])
  @@index([videoId])
  @@map("like_video")
  @@schema("core")
}

model VideoProcessing {
  id            String           @id @default(cuid())
  videoUploadId String           @unique
  status        ProcessingStatus @default(PENDING)
  errorMessage  String?
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  videoUpload   VideoUpload      @relation(fields: [videoUploadId], references: [id], onDelete: Cascade)

  @@index([createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@map("video_processing")
  @@schema("core")
}

model VideoUpload {
  id              String            @id @default(cuid())
  userId          String
  fileName        String
  mimeType        String
  fileSize        BigInt
  r2Path          String            @unique // Original video path
  videoStatus     UploadVideoStatus @default(PENDING)
  uploadedAt      DateTime          @default(now())
  completedAt     DateTime?
  processingJobId String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  videoId         String            @unique
  video           Video             @relation(fields: [videoId], references: [id], onDelete: Cascade)
  processing      VideoProcessing?
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  metaStatus      UploadMetaStatus  @default(PENDING)

  @@index([metaStatus, videoStatus])
  @@index([createdAt(sort: Desc)])
  @@index([userId, videoStatus, metaStatus])
  @@map("video_upload")
  @@schema("core")
}

model Comment {
  id         String   @id @default(cuid())
  videoId    String
  userId     String
  parentId   String?
  content    String
  likeCount  Int      @default(0)
  replyCount Int      @default(0)
  status     Int      @default(0)
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  video      Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([videoId, parentId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@schema("core")
}

model ChannelNotification {
  id                  String   @id @default(cuid())
  channelId           String
  content             String
  createdAt           DateTime @default(now())
  notificationSubject String   @map("notification_subject")
  isRead              Boolean  @default(false) @map("is_read")
  channel             User     @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId])
  @@index([channelId, createdAt(sort: Desc)])
  @@index([channelId, isRead])
  @@map("channel_notification")
  @@schema("core")
}

model SystemNotification {
  id                  String   @id @default(cuid())
  userId              String
  content             String
  createdAt           DateTime @default(now())
  notificationSubject String   @map("notification_subject")
  isRead              Boolean  @default(false) @map("is_read")
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, isRead])
  @@map("system_notification")
  @@schema("core")
}

enum UploadVideoStatus {
  PENDING
  UPLOADED
  PROCESSING
  COMPLETED
  FAILED

  @@schema("core")
}

enum UploadMetaStatus {
  PENDING
  UPDATED
  PROCESSING
  PROCESSED
  FAILED

  @@schema("core")
}

enum ProcessingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED

  @@schema("core")
}

enum VideoVisibility {
  DRAFT
  PUBLIC
  PRIVATE

  @@schema("core")
}

enum Resolution {
  x360p
  x480p
  x720p
  x1080p
  x1440p
  x2160p

  @@schema("core")
}

enum VideoStatus {
  AVAILABLE
  PROCESSING
  VIDEO_FAILED
  MERTA_FAILED

  @@schema("core")
}
